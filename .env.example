# ===== Core =====
NODE_ENV=production
PORT=3000
APP_URL=http://localhost:3000
CLIENT_URL=http://localhost:5173

# ===== Database =====
DATABASE_URL=postgres://postgres:postgres@localhost:5432/tabletennis

# ===== Security =====
SESSION_SECRET=change-me-to-a-long-random-string
SESSION_TTL_HOURS=72
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ===== Matchmaking / Game =====
MATCHMAKING_TICK_MS=1000
GAME_TICK_MS=1000
GAME_TICK_HZ=60
MATCH_DISCONNECT_GRACE_MS=30000
MATCH_POINT_SCORE=11

# ===== Redis (optional, single-instance does not require it) =====
# REDIS_URL=redis://localhost:6379

# ===== Logging =====
LOG_LEVEL=info
